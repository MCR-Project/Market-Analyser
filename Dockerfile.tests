# Runs every automated check the repo has: pytest across backend/tests and
# tests/ (fetcher fixtures), plus `npm run lint` on app/. Built from the repo
# root - not from backend/ or fetcher/ - because pytest.ini's testpaths span
# both trees and the suite needs all three requirements files at once (see
# requirements-dev.txt). No Chromium and no Supabase credentials: fetcher
# tests parse checked-in fixtures under tests/fixtures/ and backend tests
# patch their network/Supabase seams instead of reaching a real service.
FROM python:3.12-slim

# Node, for `npm run lint` - installed via NodeSource so the version matches
# what app/package.json's tooling (ESLint 10, Vite 8) expects rather than
# whatever Debian slim ships.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /repo

COPY backend/requirements.txt backend/requirements.txt
COPY fetcher/requirements.txt fetcher/requirements.txt
COPY requirements-dev.txt requirements-dev.txt
RUN pip install --no-cache-dir \
    -r backend/requirements.txt \
    -r fetcher/requirements.txt \
    -r requirements-dev.txt

COPY app/package.json app/package-lock.json app/
RUN npm ci --prefix app

COPY . .
RUN chmod +x tests-entrypoint.sh

ENTRYPOINT ["./tests-entrypoint.sh"]
