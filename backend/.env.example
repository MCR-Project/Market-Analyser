# Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Service role key (Project Settings → API → service_role secret).
# Required because RLS is enabled with no public policies on ticker/prices —
# only the service role can read/write them. Never commit this value or
# expose it to the frontend; it bypasses RLS entirely.
SUPABASE_SERVICE_KEY=your-service-role-key

# Comma-separated list of origins allowed to make cross-origin requests to
# the API. Defaults to the local frontend dev ports (localhost:5173,
# localhost:3456) when unset — see main.py.
CORS_ORIGINS=http://localhost:5173,http://localhost:3456

# Per-client request limits on /api/* (issue #93) — see rate_limit.py.
# Both default to values sized against real usage and rarely need
# changing; SIMULATE_RATE_LIMIT_PER_MINUTE is checked in addition to
# RATE_LIMIT_PER_MINUTE, not instead of it, since POST /api/portfolio/simulate
# is the most expensive request the service answers.
RATE_LIMIT_PER_MINUTE=120
SIMULATE_RATE_LIMIT_PER_MINUTE=20

# Deep-fill (issue #171, docs/adr/0006-*) - fetching a fund's Untracked holdings
# from yfinance on request and holding them in memory. Off unless explicitly
# enabled: it is ~450 tickers of downloads, more than the live demo should be
# asked to do, and nothing it fetches survives a restart. It never writes to
# Supabase. A value that is not a positive whole number falls back to its default.
ALLOW_DEEP_FILL=false
# How long a fetched ticker, and so a deep-filled fund, is kept (seconds).
DEEP_FILL_TTL_SECONDS=86400
# How many funds may be deep-filled at once; the oldest is evicted beyond this.
DEEP_FILL_MAX_FUNDS=3
# Tickers per yfinance download - also how much raw data is in memory at once.
DEEP_FILL_BATCH_SIZE=50
