# Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Service role key (Project Settings → API → service_role secret).
# Required because RLS is enabled with no public policies on ticker/prices —
# only the service role can read/write them. Never commit this value or
# expose it to the frontend; it bypasses RLS entirely.
SUPABASE_SERVICE_KEY=your-service-role-key
